# Chave do seu projeto RapidAPI. Nunca envie este valor ao GPT ou publique este arquivo.
RAPIDAPI_KEY=cole_sua_chave_aqui

# Valores exibidos na página Endpoints da API assinada no RapidAPI.
RAPIDAPI_HOST=cole_o_host_aqui
RAPIDAPI_BASE_URL=https://cole_o_host_aqui
RAPIDAPI_QUOTE_PATH=/quote/{ticker}
RAPIDAPI_HISTORY_PATH=/history/{ticker}

# Chave que o GPT usará para chamar esta API privada.
API_ACCESS_KEY=crie_uma_chave_longa_e_aleatoria
PUBLIC_BASE_URL=https://meu-gpt-b3.onrender.com

# Use somente para testar localmente sem chamar a RapidAPI.
DEMO_MODE=false
